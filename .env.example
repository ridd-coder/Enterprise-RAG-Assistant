# ============================================================
# Enterprise RAG Knowledge Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------
# Gemini
# ---------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.0

# ---------------------------
# Qdrant
# ---------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_documents
QDRANT_API_KEY=                    # Leave empty for local Qdrant

# ---------------------------
# PostgreSQL (optional)
# ---------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_assistant
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=your-postgres-password

# ---------------------------
# Application
# ---------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
SECRET_KEY=our-secret-key-change-this-in-production 

# ---------------------------
# Document Processing
# ---------------------------
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DATA_DIR=data/documents

# ---------------------------
# RAG Retrieval
# ---------------------------
TOP_K=5
MIN_RELEVANCE_SCORE=0.5
EMBEDDING_BATCH_SIZE=32

# ---------------------------
# CORS
# ---------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
